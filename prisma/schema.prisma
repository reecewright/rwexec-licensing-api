generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  REVOKED
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED
  SUSPENDED
  COMPLIMENTARY
}

enum EntitlementType {
  BOOLEAN
  LIMIT
}

model Product {
  id            String            @id @default(cuid())
  slug          String            @unique
  name          String
  description   String?
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  licenses      License[]
  plans         Plan[]
  subscriptions Subscription[]
}

model Customer {
  id            String            @id @default(cuid())
  name          String?
  email         String            @unique
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  licenses      License[]
  subscriptions Subscription[]
}

model Plan {
  id              String            @id @default(cuid())
  productId       String
  slug            String
  name            String
  description     String?
  billingInterval String?
  priceMinor      Int?
  currency        String            @default("GBP")
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  entitlements    PlanEntitlement[]
  subscriptions   Subscription[]

  @@unique([productId, slug])
  @@index([productId, active])
}

model PlanEntitlement {
  id        String          @id @default(cuid())
  planId    String
  key       String
  label     String
  type      EntitlementType
  enabled   Boolean?
  limit     Int?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  plan      Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@index([key])
}

model Subscription {
  id                     String             @id @default(cuid())
  customerId             String
  productId              String
  planId                 String?
  status                 SubscriptionStatus @default(ACTIVE)
  complimentary          Boolean            @default(false)
  externalProvider       String?
  externalCustomerId     String?
  externalSubscriptionId String?            @unique
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  customer               Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product                Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  plan                   Plan?              @relation(fields: [planId], references: [id], onDelete: SetNull)
  usage                   UsageCounter[]

  @@index([customerId, status])
  @@index([productId, status])
  @@index([externalCustomerId])
}

model UsageCounter {
  id             String       @id @default(cuid())
  subscriptionId String
  key            String
  value          Int          @default(0)
  updatedAt      DateTime     @updatedAt

  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, key])
  @@index([key])
}

model License {
  id              String         @id @default(cuid())
  keyHash         String         @unique
  keyLastFour     String
  status          LicenseStatus  @default(ACTIVE)
  activationLimit Int            @default(1)
  expiresAt       DateTime?
  productId       String
  customerId      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  product         Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  activations     Activation[]

  @@index([productId])
  @@index([customerId])
  @@index([status])
}

model Activation {
  id            String    @id @default(cuid())
  licenseId     String
  siteUrl       String
  instanceId    String
  pluginVersion String?
  activatedAt   DateTime  @default(now())
  lastCheckedAt DateTime  @default(now())
  deactivatedAt DateTime?

  license       License   @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, instanceId])
  @@index([licenseId, deactivatedAt])
  @@index([siteUrl])
}
